{
  "compilerOptions": {
    // lib ES2022 keeps JS built-ins within Chrome 106 (no toSorted, groupBy, withResolvers...).
    // DOM types are not version-limited: check newer browser APIs by hand.
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["svelte", "vite/client"],
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false
  },
  "include": ["src/**/*.ts", "src/**/*.svelte"]
}
