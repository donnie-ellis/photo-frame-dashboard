      "Bash(git push *)",
      "Bash(git restore *)",
      "Bash(git rev-parse *)",
      "Bash(git stash *)",
      "Bash(jq *)",
      "Bash(npm install *)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(npm run gen:api)",
      "Bash(npm run dev)",
